# Solo para ejecutar la preparación de la base. Nunca usar en el navegador.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Solo para habilitar el primer administrador, una vez que solicitó su cuenta.
# Los demás accesos se revisan desde Mi perfil.
FCR_ADMIN_EMAIL=
# Si el certificado del servidor requiere una CA adicional, ruta al PEM oficial.
PGSSLROOTCERT=
